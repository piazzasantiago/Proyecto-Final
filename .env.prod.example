# Copiar como .env en la raíz del repo, en el servidor. Nunca se sube a git.
# Las claves se generan en el servidor con: openssl rand -hex 32 / openssl rand -hex 24

DJANGO_SECRET_KEY=generar-con-openssl-rand
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=avigest.com.ar,www.avigest.com.ar
CSRF_TRUSTED_ORIGINS=https://avigest.com.ar,https://www.avigest.com.ar
CORS_ALLOWED_ORIGINS=https://avigest.com.ar

DB_NAME=avigest
DB_USER=avigest
DB_PASSWORD=generar-con-openssl-rand
